<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0520"
    android:padding="10dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ॐ  भक्ति Player"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFD700"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="4dp" />

    <!-- Now Playing -->
    <TextView
        android:id="@+id/tvNowPlaying"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎵  Ready"
        android:textSize="13sp"
        android:textColor="#AAAAAA"
        android:gravity="center"
        android:paddingBottom="4dp"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- Number Display -->
    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.8"
        android:text="—"
        android:textSize="64sp"
        android:textStyle="bold"
        android:textColor="#FFD700"
        android:gravity="center"
        android:background="#1A0A35"
        android:layout_marginBottom="8dp" />

    <!-- Keypad rows 1-2-3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <Button android:id="@+id/btn1"
            style="@style/KeyStyle"
            android:text="1" />
        <Button android:id="@+id/btn2"
            style="@style/KeyStyle"
            android:text="2" />
        <Button android:id="@+id/btn3"
            style="@style/KeyStyle"
            android:text="3" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <Button android:id="@+id/btn4"
            style="@style/KeyStyle"
            android:text="4" />
        <Button android:id="@+id/btn5"
            style="@style/KeyStyle"
            android:text="5" />
        <Button android:id="@+id/btn6"
            style="@style/KeyStyle"
            android:text="6" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <Button android:id="@+id/btn7"
            style="@style/KeyStyle"
            android:text="7" />
        <Button android:id="@+id/btn8"
            style="@style/KeyStyle"
            android:text="8" />
        <Button android:id="@+id/btn9"
            style="@style/KeyStyle"
            android:text="9" />
    </LinearLayout>

    <!-- Bottom row: Clear / 0 / Play -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button android:id="@+id/btnClear"
            style="@style/KeyStyle"
            android:text="⌫"
            android:backgroundTint="#660000" />
        <Button android:id="@+id/btn0"
            style="@style/KeyStyle"
            android:text="0" />
        <Button android:id="@+id/btnPlay"
            style="@style/KeyStyle"
            android:text="▶"
            android:backgroundTint="#CC6600" />
    </LinearLayout>

    <!-- Folder name -->
    <TextView
        android:id="@+id/tvFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No folder selected"
        android:textSize="11sp"
        android:textColor="#888888"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="middle"
        android:paddingBottom="4dp" />

    <!-- Choose Folder button -->
    <Button
        android:id="@+id/btnFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📁  Choose Song Folder"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#231248"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginBottom="4dp" />

</LinearLayout>
